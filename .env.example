# DocuTask Agent environment template. Copy to `.env` and fill in; never commit `.env`.
# List values are comma-separated (a JSON array also works).

# --- Runtime -----------------------------------------------------------------
# development | test | staging | production. Anything other than development/test
# enforces a strong JWT_SECRET and requires GEMINI_API_KEY and REDIS_URL for /readyz.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Auth --------------------------------------------------------------------
# Required outside development/test: at least 32 bytes. Generate: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ----------------------------------------------------------------
# SQLite for local dev; Postgres in compose/production. postgres:// URLs are accepted.
DATABASE_URL=sqlite+aiosqlite:///./docutask.db
# Used by docker-compose to build DATABASE_URL and initialise Postgres:
POSTGRES_USER=docutask
POSTGRES_PASSWORD=
POSTGRES_DB=docutask

# --- Job queue (Celery broker) and shared rate-limit counters -------------------
# Without it, POST /api/v1/jobs returns 503 QUEUE_UNAVAILABLE. Example: redis://localhost:6379/0
REDIS_URL=

# --- Gemini (the only LLM provider) ----------------------------------------------
# Key from https://aistudio.google.com/apikey. GEMINI_API_KEY wins over GOOGLE_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONNECT_TIMEOUT_SECONDS=5
GEMINI_READ_TIMEOUT_SECONDS=60

# --- Uploads -------------------------------------------------------------------
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Abuse protection ------------------------------------------------------------
# Requests per minute per client IP on /api/* (auth endpoints have stricter fixed limits).
RATE_LIMIT_PER_MINUTE=120
# CIDRs of your reverse proxies. Only then is X-Forwarded-For used (right-most untrusted hop).
# Leave empty when the app is reached directly.
TRUSTED_PROXIES=

# --- Human review ------------------------------------------------------------------
# Extractions scoring below this (0-1) go to the review queue.
CONFIDENCE_THRESHOLD_HITL=0.85

# --- docker-compose only ------------------------------------------------------------
API_PORT=8000
