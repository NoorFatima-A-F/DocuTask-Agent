# Application Setup
PROJECT_NAME="AI Document Processing Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL by default, SQLite fallback for testing)
DATABASE_URL="sqlite+aiosqlite:///./ai_doc_platform.db"
# Production Database URL Example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aidocplatform"

# Security & Authentication
JWT_SECRET="09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security Policy
MIN_PASSWORD_LENGTH=8
REQUIRE_PASSWORD_SPECIAL_CHAR=true

# Storage Settings
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_SIZE_MB=25

# Gemini AI Provider Settings
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-pro"
