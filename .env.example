# ==============================================================================
# DocuTask Agent — Environment Configuration Template (.env.example)
#
# Copy this file to '.env' and populate with local development credentials.
# NEVER commit the active '.env' file containing actual secrets to version control.
# ==============================================================================

# Core Application Settings
APP_NAME=DocuTask Agent
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server & Network
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Authentication & Security
# Required outside ENVIRONMENT=development|test: the app refuses to start with the default
# or a secret shorter than 32 bytes. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (PostgreSQL or SQLite)
# Example: postgresql+asyncpg://user:password@localhost:5432/docutask
DATABASE_URL=sqlite+aiosqlite:///./docutask.db

# Task Queue & Cache (Redis)
# Example: redis://localhost:6379/0
REDIS_URL=

# Gemini (the only LLM provider). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY takes precedence; GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Document Storage Path
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50

# Human-in-the-loop (HITL) Routing Threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD_HITL=0.85
