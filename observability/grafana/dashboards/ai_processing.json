{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Document Throughput (Docs/min)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(docutask_documents_processed_total[1m])) * 60", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Document Processing Latency (P50, P95, P99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(docutask_document_processing_seconds_bucket[5m])) by (le))", "refId": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(docutask_document_processing_seconds_bucket[5m])) by (le))", "refId": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(docutask_document_processing_seconds_bucket[5m])) by (le))", "refId": "P99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Extraction Quality & Validation Failures",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(docutask_successful_extractions_total[5m]))", "refId": "Success" },
        { "expr": "sum(rate(docutask_validation_failures_total[5m]))", "refId": "Failures" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Gemini AI Requests & 503 Errors",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(docutask_gemini_requests_total[5m]))", "refId": "Requests" },
        { "expr": "sum(rate(docutask_gemini_failures_total[5m]))", "refId": "Errors" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "id": 5,
      "title": "LLM Token Usage (Input / Output)",
      "type": "timeseries",
      "targets": [{ "expr": "sum(rate(docutask_llm_tokens_consumed_total[5m])) by (type)", "refId": "A" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["docutask", "ai", "gemini"],
  "title": "AI Processing Intelligence",
  "uid": "docutask-ai-processing",
  "version": 1
}
