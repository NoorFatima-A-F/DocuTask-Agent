###############################################################################
# DocuTask Agent — Enterprise Clean .gitignore
###############################################################################

# 1. Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.token

# 2. Python Build & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 3. Virtual Environments
.venv/
venv/
env/

# 4. Node.js, Frontend & Build Binaries
node_modules/
frontend/node_modules/
frontend/dist/
.eslintcache
npm-debug.log*
yarn-debug.log*

# 5. OS & Large Binary Artifacts
*.exe
*.dll
*.dylib
codeql_alerts.json
*_alerts.json
*alerts*.json

# 6. Database & Local Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
storage/uploads/*
!storage/uploads/.gitkeep
tmp/
temp/
