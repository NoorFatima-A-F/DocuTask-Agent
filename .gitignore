###############################################################################
# DocuTask Agent — Enterprise Production .gitignore
#
# Follows enterprise standards (CNCF, Google OSS, Microsoft, HashiCorp, Kubernetes)
# Ensures zero secret leakage, clean workspace isolation, reproducible CI/CD builds,
# and high-performance developer workflows across distributed teams.
###############################################################################

###############################################################################
# 1. Environment & Secrets (Zero-Trust Security Enforcement)
# Prevents accidental commitment of credentials, API tokens, and secret keys.
###############################################################################
.env
.env.*
!.env.example
!.env.template
!.env.test

# Cloud Provider Credentials & Service Accounts
*credentials*.json
*service-account*.json
*service_account*.json
gcp-key*.json
aws-credentials*
azure-credentials*
.aws/
.gcp/
.azure/

# Cryptographic Keys, Certificates & Signatures
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
*.sops
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Sigstore, Cosign & Software Supply Chain Secrets
cosign.key
*.sigstore.key
*.signing-key

# Vault & Key Management Tokens
.vault-token
vault-token*

###############################################################################
# 2. Python Build Artifacts, Bytecode & Packaging
# Excludes compiled bytecode, distribution archives, and packaging metadata.
###############################################################################
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Installer & Packaging Tools Cache
.pip-cache/
.wheel-cache/
pip-log.txt
pip-delete-this-directory.txt

###############################################################################
# 3. Virtual Environments & Dependency Managers
# Excludes local virtual environment runtime trees while retaining lockfiles.
###############################################################################
.venv/
venv/
venv-*/
env/
env-*/
ENV/
.env-*/
.pdm-build/
.nox/
.tox/
.hypothesis/
.cache/

# Conda / Pipenv / Poetry local dirs
.conda/
.pipenv/

###############################################################################
# 4. Testing, Quality Assurance & Linting
# Excludes test runner caches, benchmark outputs, and linter scratch directories.
###############################################################################
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.coverage
.coverage.*
.coveragerc.*
htmlcov/
coverage.xml
coverage.json
*.cover
*.py,cover
.benchmarks/
nosetests.xml
coverage_html_report/
test-reports/
junit-*.xml
audit_output/

###############################################################################
# 5. Database, Transient Storage & Local Dumps
# Excludes local development databases, WAL logs, and memory dumps.
# NOTE: Never excludes database migration source code (e.g. alembic/versions).
###############################################################################
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.sql.bak
*.dump
local_postgres_data/
postgres-data/
redis-data/

###############################################################################
# 6. Document Storage, OCR & Intermediate Processing Artifacts
# Excludes user-uploaded documents, OCR raster caches, and pipeline scratch files.
###############################################################################
storage/uploads/
storage/temp/
storage/processed/
storage/ocr_cache/
storage/quarantine/
storage/exports/
data/raw/
data/processed/
data/interim/
data/cache/
*.pdf.ocr.*
*.tiff.cache
*.temp_artifact

###############################################################################
# 7. AI Models, Embeddings & Vector Index Cache
# Excludes local embedding caches, model weight mirrors, and prompt eval dumps.
# NOTE: Retains prompt templates, eval benchmarks, and model configurations.
###############################################################################
.chroma/
.faiss/
.qdrant/
vector_store/
embeddings_cache/
model_weights/
*.onnx.cache
*.safetensors.cache
evaluation_results/
eval_runs/
prompt_runs/

###############################################################################
# 8. Node.js, React & Frontend Build Artifacts
# Excludes node package distributions, Vite build bundles, and UI runtime caches.
###############################################################################
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.parcel-cache/
.next/
out/

###############################################################################
# 9. Logs, Tracing & Profiling Dumps
# Excludes runtime operational logs, SRE crash dumps, and CPU/memory profiles.
###############################################################################
*.log
logs/
log/
*.log.*
*.prof
*.pstats
*.cprofile
*.heap
core
core.*
*.pid

###############################################################################
# 10. Docker, Containers & Kubernetes Local State
# Excludes developer compose overrides, volume mounts, and local kubeconfigs.
# NOTE: Retains primary Dockerfile, docker-compose.yml, and manifest sources.
###############################################################################
docker-compose.override.yml
docker-compose.local.yml
.docker/
*.container.sock
local_cluster_state/
.kube/
kubeconfig.local
kubeconfig.dev
*.rendered.yaml

###############################################################################
# 11. Infrastructure as Code (Terraform & Helm)
# Excludes local terraform states, plan files, and packaged charts.
###############################################################################
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc
charts/*.tgz

###############################################################################
# 12. IDEs, Editors & Developer Tooling
# Excludes local editor workspaces, indexing directories, and user settings.
###############################################################################
# Visual Studio Code
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
!.vscode/launch.json.example

# Cursor AI Editor
.cursor/
.cursorrules.local

# JetBrains (PyCharm, IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio
.vs/
*.sln.docstates

# Sublime Text / Atom / Fleet
*.sublime-workspace
*.sublime-project
.fleet/

# Vim / Emacs
[._]*.s[a-v][a-z]
[._]*.un~
Session.vim
*~
\#*\#
.#*

###############################################################################
# 13. Operating System Metadata & Transient Files
# Excludes OS-specific thumbnail caches, filesystem indices, and trash bins.
###############################################################################
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.directory
.Trash-*

###############################################################################
# 14. Temporary Files, Scratchpads & Agent Workspaces
###############################################################################
tmp/
temp/
scratch/
scratch_*/
*.tmp
*.bak
*.swp
*.orig
*.rej
