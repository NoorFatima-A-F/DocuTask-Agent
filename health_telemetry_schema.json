{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthTelemetrySchema",
  "description": "Standardized schema for predictive health intelligence telemetry metrics",
  "type": "object",
  "properties": {
    "metric": {
      "type": "string",
      "description": "Telemetry metric identifier (e.g., worker.queue_depth, postgres.connections)"
    },
    "service": {
      "type": "string",
      "description": "Originating service name"
    },
    "value": {
      "type": "number",
      "description": "Observed metric value"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (e.g. %, ms, count, bytes)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 observation timestamp"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context tags"
    }
  },
  "required": ["metric", "service", "value", "unit", "timestamp"]
}
